{
  "schemaVersion": 1,
  "id": "community-block",
  "version": "${version}",
  "name": "Community Block",
  "description": "An addon for Meteor client to block chat spam",
  "authors": [
    "IceTank"
  ],
  "contact": {
    "repo": "https://github.com/MeteorDevelopment/meteor-addon-template"
  },
  "icon": "assets/template/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": [
      "org.icetank.communityblock.CommunityBlock"
    ]
  },
  "mixins": [
    "addon-template.mixins.json"
  ],
  "custom": {
    "meteor-client:color": "225,25,25"
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${mc_version}"],
    "meteor-client": "*"
  }
}
